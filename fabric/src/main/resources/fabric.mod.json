{
  "schemaVersion": 1,
  "id": "atlasvfx",
  "version": "${version}",
  "name": "AtlasVFX",
  "description": "Visual effects drawn from the game's own sprite atlases: soft light, rings, beams, motes and shapes, with no textures of its own.",
  "authors": ["eann"],
  "license": "MIT",
  "environment": "*",
  "accessWidener": "atlasvfx.accesswidener",
  "mixins": ["atlasvfx.mixins.json"],
  "entrypoints": {
    "main": ["dev.eann.atlasvfx.fabric.AtlasVfxFabric"],
    "client": ["dev.eann.atlasvfx.fabric.AtlasVfxFabricClient"]
  },
  "depends": {
    "fabricloader": ">=0.16.0",
    "fabric-api": "*",
    "architectury": ">=13.0.0",
    "minecraft": "~1.21.1",
    "java": ">=21"
  }
}
